# Frontend (injected at build time, no VITE_ prefix needed)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
R2_SIGNER_URL=https://lexora-r2-signer.<your-subdomain>.workers.dev

# Cloudflare Worker secrets (server-side only, never expose to the browser)
# Set in Wrangler with: npx wrangler secret put <NAME>
SUPABASE_SECRET_KEY=...
R2_ACCOUNT_ID=...
R2_BUCKET=documents
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...
APP_ORIGIN=http://localhost:5173,https://lexora.vercel.app
